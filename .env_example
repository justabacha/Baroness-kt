# Supabase Project Configuration
# Copy this file to .env and fill in the actual values

# The Project Ref found in Project Settings -> General
SUPABASE_PROJECT_ID=your-project-ref-here

# Database connection string (Project Settings -> Database -> Connection string)
# RECOMMENDATION: Use the "Transaction Pooler" URI (Port 6543) if you have network issues.
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Service Role Key (Project Settings -> API -> service_role secret)
# IMPORTANT: Never commit the actual .env file to version control
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
